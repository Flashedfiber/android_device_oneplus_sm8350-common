+    @VisibleForTesting
+    static class FrequencyOption {
+        final Integer frequencyMhz;
+        final String label;
+        final List<MacAddress> bssidAllowlist;
+
+        FrequencyOption(Integer frequencyMhz, String label, List<MacAddress> bssidAllowlist) {
+            this.frequencyMhz = frequencyMhz;
+            this.label = label;
+            this.bssidAllowlist = bssidAllowlist;
+        }
+
+        boolean isAutomatic() {
+            return frequencyMhz == null;
+        }
+    }
+
+    @VisibleForTesting
+    List<FrequencyOption> getFrequencyOptions() {
+        if (!canModifyNetwork() || mWifiEntry.getWifiConfiguration() == null) {
+            return Collections.emptyList();
+        }
+        final List<ScanResult> scanResults = mWifiEntry.getScanResults();
+        if (scanResults == null || scanResults.isEmpty()) {
+            return Collections.emptyList();
+        }
+
+        final Map<Integer, LinkedHashMap<String, MacAddress>> bssidsByFrequency =
+                new LinkedHashMap<>();
+        for (ScanResult scanResult : scanResults) {
+            if (scanResult == null || TextUtils.isEmpty(scanResult.BSSID)
+                    || scanResult.frequency <= 0) {
+                continue;
+            }
+
+            final MacAddress macAddress;
+            try {
+                macAddress = MacAddress.fromString(scanResult.BSSID);
+            } catch (IllegalArgumentException e) {
+                Log.w(TAG, "Skipping scan result with invalid BSSID: " + scanResult.BSSID, e);
+                continue;
+            }
+
+            bssidsByFrequency.computeIfAbsent(scanResult.frequency, key -> new LinkedHashMap<>())
+                    .put(macAddress.toString(), macAddress);
+        }
+        if (bssidsByFrequency.isEmpty()) {
+            return Collections.emptyList();
+        }
+
+        final List<FrequencyOption> options = new ArrayList<>();
+        options.add(new FrequencyOption(
+                null,
+                mContext.getString(R.string.wifi_frequency_auto),
+                Collections.emptyList()));
+        bssidsByFrequency.entrySet().stream()
+                .sorted(Map.Entry.comparingByKey())
+                .forEach(entry -> options.add(new FrequencyOption(
+                        entry.getKey(),
+                        getFrequencyLabel(entry.getKey()),
+                        new ArrayList<>(entry.getValue().values()))));
+        return options;
+    }
+
+    private String getFrequencySummary(List<FrequencyOption> options) {
+        final FrequencyOption selectedOption = getSelectedFrequencyOption(options);
+        final String currentFrequency = getConnectedFrequencyLabel();
+        if (selectedOption == null) {
+            if (hasFrequencyRestriction()) {
+                if (!TextUtils.isEmpty(currentFrequency)) {
+                    return mContext.getString(R.string.wifi_frequency_forced, currentFrequency);
+                }
+                return mContext.getString(R.string.wifi_frequency_custom_restriction);
+            }
+            if (!TextUtils.isEmpty(currentFrequency)) {
+                return mContext.getString(
+                        R.string.wifi_frequency_auto_with_current, currentFrequency);
+            }
+            return mWifiEntry.getBandString();
+        }
+        if (selectedOption.isAutomatic()) {
+            if (!TextUtils.isEmpty(currentFrequency)) {
+                return mContext.getString(
+                        R.string.wifi_frequency_auto_with_current, currentFrequency);
+            }
+            return selectedOption.label;
+        }
+        return mContext.getString(R.string.wifi_frequency_forced, selectedOption.label);
+    }
+
+    private String getConnectedFrequencyLabel() {
+        final WifiEntry.ConnectedInfo connectedInfo = mWifiEntry.getConnectedInfo();
+        if (connectedInfo == null || connectedInfo.frequencyMhz == WifiEntry.FREQUENCY_UNKNOWN) {
+            return null;
+        }
+        return getFrequencyLabel(connectedInfo.frequencyMhz);
+    }
+
+    private String getFrequencyLabel(int frequencyMhz) {
+        final NumberFormat formatter = NumberFormat.getNumberInstance();
+        formatter.setMinimumFractionDigits(0);
+        formatter.setMaximumFractionDigits(3);
+        final String frequencyGhz = formatter.format(frequencyMhz / 1000d);
+        final int channel = ScanResult.convertFrequencyMhzToChannelIfSupported(frequencyMhz);
+        if (channel == ScanResult.UNSPECIFIED) {
+            return mContext.getString(R.string.wifi_frequency_ghz, frequencyGhz);
+        }
+        return mContext.getString(R.string.wifi_frequency_ghz_channel, frequencyGhz, channel);
+    }
+
+    private boolean hasFrequencyRestriction() {
+        final WifiConfiguration config = mWifiEntry.getWifiConfiguration();
+        return config != null && config.getBssidAllowlist() != null;
+    }
+
+    private FrequencyOption getSelectedFrequencyOption(List<FrequencyOption> options) {
+        final WifiConfiguration config = mWifiEntry.getWifiConfiguration();
+        if (config == null) {
+            return null;
+        }
+        final List<MacAddress> currentAllowlist = config.getBssidAllowlist();
+        if (currentAllowlist == null) {
+            return options.isEmpty() ? null : options.get(0);
+        }
+        if (currentAllowlist.isEmpty()) {
+            return null;
+        }
+
+        final List<String> currentAllowlistStrings = currentAllowlist.stream()
+                .map(MacAddress::toString)
+                .sorted()
+                .collect(Collectors.toList());
+        FrequencyOption partialMatch = null;
+        for (FrequencyOption option : options) {
+            if (option.isAutomatic()) {
+                continue;
+            }
+            final List<String> optionBssids = option.bssidAllowlist.stream()
+                    .map(MacAddress::toString)
+                    .sorted()
+                    .collect(Collectors.toList());
+            if (optionBssids.equals(currentAllowlistStrings)) {
+                return option;
+            }
+            for (String bssid : optionBssids) {
+                if (currentAllowlistStrings.contains(bssid)) {
+                    if (partialMatch != null && partialMatch != option) {
+                        return null;
+                    }
+                    partialMatch = option;
+                    break;
+                }
+            }
+        }
+        return partialMatch;
+    }
+
+    private void showFrequencyDialog() {
+        final Activity activity = mFragment.getActivity();
+        if (activity == null) {
+            return;
+        }
+
+        final List<FrequencyOption> options = getFrequencyOptions();
+        if (options.isEmpty()) {
+            return;
+        }
+
+        dismissFrequencyDialog();
+        final FrequencyOption selectedOption = getSelectedFrequencyOption(options);
+        final int checkedItem = selectedOption == null ? -1 : options.indexOf(selectedOption);
+        final CharSequence[] labels = options.stream()
+                .map(option -> option.label)
+                .toArray(CharSequence[]::new);
+        mFrequencyDialog = new AlertDialog.Builder(activity)
+                .setTitle(R.string.wifi_frequency)
+                .setSingleChoiceItems(labels, checkedItem, (dialog, which) -> {
+                    dialog.dismiss();
+                    applyFrequencyOption(options.get(which));
+                })
+                .setNegativeButton(R.string.cancel, null)
+                .create();
+        mFrequencyDialog.show();
+    }
+
+    private void dismissFrequencyDialog() {
+        if (mFrequencyDialog == null) {
+            return;
+        }
+        mFrequencyDialog.dismiss();
+        mFrequencyDialog = null;
+    }
+
+    private boolean shouldReconnectForFrequencyChange(FrequencyOption option) {
+        if (option.isAutomatic()) {
+            return false;
+        }
+        final WifiEntry.ConnectedInfo connectedInfo = mWifiEntry.getConnectedInfo();
+        return connectedInfo != null
+                && connectedInfo.frequencyMhz != WifiEntry.FREQUENCY_UNKNOWN
+                && connectedInfo.frequencyMhz != option.frequencyMhz;
+    }
+
+    @VisibleForTesting
+    void applyFrequencyOption(FrequencyOption option) {
+        final WifiConfiguration config = mWifiEntry.getWifiConfiguration();
+        if (config == null) {
+            return;
+        }
+
+        final String previousBssid = config.BSSID;
+        final List<MacAddress> previousAllowlist = config.getBssidAllowlist();
+        final boolean reconnect = shouldReconnectForFrequencyChange(option);
+
+        config.BSSID = null;
+        config.setBssidAllowlist(option.isAutomatic() ? null : option.bssidAllowlist);
+        refreshFrequency();
+        mWifiManager.save(config, new WifiManager.ActionListener() {
+            @Override
+            public void onSuccess() {
+                if (reconnect) {
+                    mWifiEntry.connect(WifiDetailPreferenceController2.this);
+                }
+            }
+
+            @Override
+            public void onFailure(int reason) {
+                config.BSSID = previousBssid;
+                config.setBssidAllowlist(previousAllowlist);
+                refreshFrequency();
+                Toast.makeText(mContext, R.string.wifi_frequency_update_failed,
+                        Toast.LENGTH_SHORT).show();
+            }
+        });
+    }
+
     private void refreshSecurity() {
         mSecurityPref.setSummary(mWifiEntry.getSecurityString(false /* concise */));
     }
